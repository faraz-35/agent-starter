{
  "exclude": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.vercel/**",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    ".env*",
    "package-lock.json",
    "pnpm-lock.yaml",
    "**/*.map",
    "**/*.min.js"
  ],
  "intelligentRepomix": {
    "enabled": true,
    "description": "Use the intelligent repomix script that auto-detects feature files based on the Next.js Production Starter Template architecture",
    "script": "scripts/repomix.js",
    "features": {
      "autoDetect": true,
      "includeParentCommon": true,
      "includeFeatureCommon": true,
      "includeApiRoutes": true,
      "includeConfigFiles": true
    },
    "output": {
      "style": "xml",
      "removeComments": false,
      "removeEmptyLines": true,
      "topFilesLength": 10
    }
  },
  "legacyFeatures": {
    "note": "These are preserved for backward compatibility. Use 'node scripts/repomix.js <feature>' instead.",
    #!/usr/bin/env node

    import { execSync } from "child_process";
    import fs from "fs";
    import path from "path";

    /**
     * Intelligent Repomix Script for Next.js Production Starter Template
     *
     * This script automatically detects feature files and their dependencies
     * based on the architectural principles defined in CLAUDE.md. It now includes
     * advanced options for filtering, minimal builds, and dependency management.
     *
     * Usage: node scripts/repomix.js <feature-name> [options]
     * Example: node scripts/repomix.js settings --minimal
     * Example: node scripts/repomix.js auth --exclude "**/ui/**"
     */

    const CONFIG_FILE = "repomix.json";
    const APP_DIR = "app";

    // Load the base configuration from repomix.json
    function loadConfig() {
      if (fs.existsSync(CONFIG_FILE)) {
        return JSON.parse(fs.readFileSync(CONFIG_FILE, "utf-8"));
      }
      // Provide a default fallback configuration
      return {
        exclude: [
          "**/node_modules/**",
          "**/.next/**",
          "**/.vercel/**",
          "**/.git/**",
          "**/dist/**",
          "**/build/**",
          ".env*",
          "package-lock.json",
          "pnpm-lock.yaml",
          "**/*.map",
          "**/*.min.js",
        ],
      };
    }

    /**
     * Find the feature directory in the app/ folder.
     * Handles nested features (e.g., "dashboard/settings") and route groups.
     */
    function findFeatureDirectory(featureName) {
      const pathParts = featureName.split("/");
      const mainFeature = pathParts[0];
      const subFeature = pathParts.slice(1).join("/");

      const possiblePaths = [
        path.join(APP_DIR, featureName),
        path.join(APP_DIR, `(${featureName})`),
      ];

      // 1. Try for an exact match first
      for (const featurePath of possiblePaths) {
        if (fs.existsSync(featurePath)) {
          return featurePath;
        }
      }

      // 2. For nested features, find the main feature directory first
      if (subFeature) {
        const mainFeaturePaths = [
          path.join(APP_DIR, mainFeature),
          path.join(APP_DIR, `(${mainFeature})`),
        ];

        for (const mainPath of mainFeaturePaths) {
          if (fs.existsSync(mainPath)) {
            const subPath = path.join(mainPath, subFeature);
            if (fs.existsSync(subPath)) {
              return subPath;
            }
          }
        }
      }

      // 3. Fallback: Search for any directory that includes the feature name
      const allDirs = fs
        .readdirSync(APP_DIR, { withFileTypes: true })
        .filter((dirent) => dirent.isDirectory())
        .map((dirent) => dirent.name);

      for (const dirName of allDirs) {
        if (dirName.toLowerCase().includes(mainFeature.toLowerCase())) {
          const fullPath = path.join(APP_DIR, dirName);
          if (subFeature) {
            const subPath = path.join(fullPath, subFeature);
            if (fs.existsSync(subPath)) {
              return subPath;
            }
          } else {
            return fullPath;
          }
        }
      }

      throw new Error(`Feature directory not found for "${featureName}"`);
    }

    /**
     * Get all parent (common) directories that should be included.
     */
    function getParentCommonDirectories() {
      const parentCommonPath = path.join(APP_DIR, "(common)");
      return fs.existsSync(parentCommonPath) ? [parentCommonPath] : [];
    }

    /**
     * Recursively find all (common) directories within a specific feature.
     */
    function findFeatureCommonDirectories(featurePath) {
      const commonDirs = [];
      function findCommon(dir) {
        if (!fs.existsSync(dir)) return;
        const items = fs.readdirSync(dir, { withFileTypes: true });

        for (const item of items) {
          if (item.isDirectory()) {
            const fullPath = path.join(dir, item.name);
            if (item.name === "(common)") {
              commonDirs.push(fullPath);
            }
            findCommon(fullPath); // Recurse into subdirectories
          }
        }
      }
      findCommon(featurePath);
      return commonDirs;
    }

    /**
     * Find all API routes associated with this feature.
     */
    function findFeatureApiRoutes(featureName) {
      const apiRoutes = [];
      const globalApiPath = path.join(APP_DIR, "api", featureName);

      if (fs.existsSync(globalApiPath)) {
        apiRoutes.push(`${globalApiPath}/**`);
      }

      // Note: API routes within a feature directory are already included by the feature path glob.
      return apiRoutes;
    }

    /**
     * Find all files and directories for a given feature based on CLI options.
     */
    function getFeatureFiles(featureName, options = {}) {
      const featurePath = findFeatureDirectory(featureName);
      console.log(`🔍 Found feature directory: ${featurePath}`);

      const files = [];

      // 1. Include all files in the feature directory itself
      files.push(`${featurePath}/**`);

      // 2. Include all feature-specific (common) directories (unless in minimal mode)
      if (!options.minimal) {
        const featureCommonDirs = findFeatureCommonDirectories(featurePath);
        files.push(...featureCommonDirs.map((dir) => `${dir}/**`));
      }

      // 3. Include parent (common) directory based on options
      if (!options.noParentCommon && !options.minimal) {
        const parentCommonDirs = getParentCommonDirectories();
        if (options.parentDepth > 0) {
          // Only include up to the specified depth
          parentCommonDirs.slice(0, options.parentDepth).forEach((dir) => {
            files.push(`${dir}/**`);
          });
        } else {
          // Include all parent common directories
          files.push(...parentCommonDirs.map((dir) => `${dir}/**`));
        }
      }

      // 4. Include related API routes (unless in minimal mode)
      if (!options.minimal) {
        const apiRoutes = findFeatureApiRoutes(featureName);
        files.push(...apiRoutes);
      }

      // 5. Include essential root files (unless in minimal mode)
      if (!options.minimal) {
        const rootFiles = ["app/layout.tsx", "app/(home)/page.tsx"];
        files.push(...rootFiles.filter((file) => fs.existsSync(file)));
      }

      // 6. Include configuration files (a minimal set for minimal mode)
      if (options.minimal) {
        files.push("package.json", "tsconfig.json", "next.config.*");
      } else {
        const configFiles = [
          "tailwind.config.*",
          "next.config.*",
          "tsconfig.json",
          "package.json",
        ];
        files.push(...configFiles);
      }

      // 7. Include environment example file (unless in minimal mode)
      if (fs.existsSync(".env.local.example") && !options.minimal) {
        files.push(".env.local.example");
      }

      return files;
    }

    /**
     * Generate a descriptive output filename based on feature and options.
     */
    function generateOutputFilename(featureName, options = {}) {
      const timestamp = new Date().toISOString().split("T")[0];
      const suffix = options.minimal
        ? "-minimal"
        : options.noParentCommon
          ? "-no-parent"
          : options.parentDepth > 0
            ? `-depth-${options.parentDepth}`
            : options.exclude && options.exclude.length > 0
              ? "-filtered"
              : "";
      return `repomix-${featureName.replace("/", "-")}${suffix}-${timestamp}.xml`;
    }

    /**
     * Convert simple exclusion patterns to more comprehensive glob patterns.
     */
    function processExclusionPatterns(patterns) {
      return patterns
        .map((pattern) => {
          // If it's a simple word like "ui", expand it to cover common cases
          if (!pattern.includes("*") && !pattern.includes("/")) {
            return [`**/${pattern}/**`, `**/${pattern}.*`];
          }
          return pattern;
        })
        .flat();
    }

    /**
     * Create a temporary repomix configuration and run the command.
     */
    function runRepomix(featureName, files, config, options = {}) {
      // Combine base exclusions with user-provided exclusions from CLI
      const userExclusions = options.exclude || [];
      const processedExclusions = processExclusionPatterns(userExclusions);
      const allExclusions = [...(config.exclude || []), ...processedExclusions];

      const tempConfig = {
        $schema: "https://repomix.dev/schema.json",
        exclude: allExclusions,
        include: files,
        output: {
          filePath: generateOutputFilename(featureName, options),
          style: "xml",
          removeComments: false,
          removeEmptyLines: true,
          topFilesLength: 10,
          headerText: `# Repomix for Feature: ${featureName}

    ## Bundle Configuration
    ${options.minimal ? "- ✅ Minimal mode: Only essential feature files are included." : "- 🔵 Full mode: Complete context with shared dependencies."}
    ${options.noParentCommon ? "- 🚫 Parent (common) directory excluded." : `- ✅ Parent (common) directory included.${options.parentDepth > 0 ? ` (Depth: ${options.parentDepth})` : ""}`}
    ${options.exclude && options.exclude.length > 0 ? `- 🚫 Exclusions: ${options.exclude.join(", ")}` : "- ✅ No custom exclusions."}

    ## Feature Structure
    This bundle contains:
    ${
      options.minimal
        ? `- Core feature directory: ${findFeatureDirectory(featureName)}/**
    - Essential configuration files (package.json, tsconfig.json, next.config.*)`
        : `- Complete feature directory with all sub-features and its own (common) directories.
    - ${options.noParentCommon ? "Parent (common) directory EXCLUDED as requested." : "Parent (common) directory for globally shared utilities."}
    - Related API routes and proxy files.
    - Root layout and configuration files for full context.`
    }

    ## Architecture Notes
    - Features are designed for adaptive self-containment.
    - (common) directories hold shared logic to prevent duplication.
    - All necessary imports and dependencies are included unless excluded.

    Generated on: ${new Date().toISOString()}
    `,
        },
      };

      const tempConfigPath = "repomix.temp.json";
      fs.writeFileSync(tempConfigPath, JSON.stringify(tempConfig, null, 2));

      console.log(`\n📦 Running repomix for feature: ${featureName}`);
      console.log(`📄 Output will be saved to: ${tempConfig.output.filePath}`);
      console.log(`📁 Including ${files.length} file/directory patterns.`);
      if (processedExclusions.length > 0) {
        console.log(`🚫 Applying ${processedExclusions.length} exclusion patterns.`);
      }

      try {
        execSync(`npx repomix --config ${tempConfigPath}`, { stdio: "inherit" });
        console.log(`\n✅ Successfully generated repomix for ${featureName}`);
        console.log(`📁 Output file: ${tempConfig.output.filePath}`);
      } catch (error) {
        console.error(`\n❌ Error running repomix: ${error.message}`);
        process.exit(1);
      } finally {
        if (fs.existsSync(tempConfigPath)) {
          fs.unlinkSync(tempConfigPath);
        }
      }
    }

    /**
     * List all available features found in the app/ directory.
     */
    function listAvailableFeatures() {
      console.log("🔍 Available features:");
      if (!fs.existsSync(APP_DIR)) {
        console.log("❌ app/ directory not found.");
        return;
      }

      const items = fs
        .readdirSync(APP_DIR, { withFileTypes: true })
        .filter((dirent) => dirent.isDirectory())
        .map((dirent) => dirent.name)
        .sort();

      const features = new Set();
      const infrastructureDirs = ["(common)", "api"];

      items.forEach((item) => {
        if (infrastructureDirs.includes(item)) return;

        const itemPath = path.join(APP_DIR, item);
        const subItems = fs.readdirSync(itemPath, { withFileTypes: true });

        // A directory is a feature if it has a page.tsx or layout.tsx
        const isFeature = subItems.some((dirent) =>
          ["page.tsx", "layout.tsx"].includes(dirent.name)
        );

        if (isFeature) {
          features.add(item.replace(/[()]/g, "")); // Add feature, removing route group brackets
        }

        // Check for nested features
        subItems.forEach((subItem) => {
          if (subItem.isDirectory()) {
            const subItemPath = path.join(itemPath, subItem.name);
            const hasPage = fs.existsSync(path.join(subItemPath, "page.tsx"));
            if (hasPage) {
              features.add(`${item.replace(/[()]/g, "")}/${subItem.name}`);
            }
          }
        });
      });

      if (features.size === 0) {
        console.log("  No feature directories found.");
        return;
      }

      features.forEach((feature) => console.log(`  ➡️ ${feature}`));

      console.log("\nUsage examples:");
      const exampleFeature = [...features][0].split('/')[0]; // Get the first base feature for example
      if (exampleFeature) {
          console.log(`  pnpm repomix ${exampleFeature}`);
          console.log(`  pnpm repomix ${exampleFeature} --minimal`);
          console.log(`  pnpm repomix ${exampleFeature} --exclude "**/ui/**" --exclude "**/hooks/**"`);
      }
    }

    /**
     * Parse command-line arguments into a structured options object.
     */
    function parseArgs() {
      const args = process.argv.slice(2);
      const options = {
        featureName: null,
        list: false,
        help: false,
        exclude: [],
        noParentCommon: false,
        parentDepth: 0,
        minimal: false,
      };

      for (let i = 0; i < args.length; i++) {
        const arg = args[i];

        if (arg === "--list" || arg === "-l") {
          options.list = true;
        } else if (arg === "--help" || arg === "-h") {
          options.help = true;
        } else if (arg === "--exclude" || arg === "-e") {
          const nextArg = args[i + 1];
          if (nextArg && !nextArg.startsWith("--")) {
            options.exclude.push(nextArg);
            i++; // Skip next argument as it's a value
          }
        } else if (arg === "--no-parent-common") {
          options.noParentCommon = true;
        } else if (arg === "--parent-depth") {
          const depth = parseInt(args[i + 1], 10);
          if (!isNaN(depth) && depth >= 0) {
            options.parentDepth = depth;
            i++;
          }
        } else if (arg === "--minimal" || arg === "-m") {
          options.minimal = true;
        } else if (!arg.startsWith("--") && !options.featureName) {
          options.featureName = arg;
        }
      }
      return options;
    }

    /**
     * Main execution block
     */
    function main() {
      const options = parseArgs();

      if (options.help) {
        console.log(`
    🔧 Intelligent Repomix Script for Next.js

    This script automatically finds all relevant files for a given feature,
    with advanced options for fine-tuning the output bundle.

    Usage:
      pnpm repomix <feature-name> [options]
      pnpm repomix --list
      pnpm repomix --help

    Options:
      -e, --exclude <pattern>    Exclude files/folders. Can be used multiple times.
                                 (e.g., --exclude "**/ui/**")
      -m, --minimal              Minimal mode: only include essential feature files,
                                 excluding shared libs and parent common code.
      --no-parent-common         Exclude the global app/(common) directory.
      --parent-depth <number>    Limit parent common directory depth (0 for unlimited).
      -l, --list                 List all available, auto-detected features.
      -h, --help                 Show this help message.

    Examples:
      pnpm repomix dashboard                           # Bundle the full dashboard feature
      pnpm repomix dashboard --minimal                 # Minimal bundle for dashboard
      pnpm repomix dashboard --exclude "**/ui/**"      # Exclude all UI components
      pnpm repomix auth --exclude "**/hooks/**" --exclude "**/*.test.ts"
      pnpm repomix dashboard/settings --no-parent-common
    `);
        return;
      }

      if (options.list) {
        listAvailableFeatures();
        return;
      }

      if (!options.featureName) {
        console.error("❌ No feature name provided.");
        console.log("\nUsage: pnpm repomix <feature-name> [options]");
        console.log("Run 'pnpm repomix --help' for all commands.");
        process.exit(1);
      }

      try {
        const config = loadConfig();
        const files = getFeatureFiles(options.featureName, options);
        runRepomix(options.featureName, files, config, options);
      } catch (error) {
        console.error(`\n❌ An error occurred: ${error.message}`);
        process.exit(1);
      }
    }

    // Ensure the script is being run directly
    main();      "include": ["src/app/auth/**"]
    }
  }
}
